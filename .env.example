# ---- Required ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- AI model (optional, defaults shown) ----
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# true = competitors researched with live Google Search (more accurate, adds search cost)
ENABLE_SEARCH_GROUNDING=false

# Pricing used for the cost estimate in each response (USD per 1M tokens)
PRICE_INPUT_PER_MILLION=0.25
PRICE_OUTPUT_PER_MILLION=1.50

# ---- Limits (optional) ----
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=86400
LOG_LEVEL=INFO
